# Copy to .env at the repo root on the VPS and fill in real values.
# Referenced by both systemd units via EnvironmentFile=.

# sqlite:////opt/purdue-seat-watch/data/prod.db, or a postgresql:// URL later if this
# ever outgrows SQLite. Leave unset locally to default to ./local.db.
DATABASE_URL=sqlite:////opt/purdue-seat-watch/data/prod.db

RESEND_API_KEY=re_xxx
EMAIL_FROM=Purdue Seat Watch <onboarding@resend.dev>
POLL_INTERVAL_SECONDS=90
